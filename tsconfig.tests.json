{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The specs reach the browser tree (`src/client/*.tsx`) as well as the
    // server tree, so this project needs the union of both projects' options:
    // DOM for the client's `document`/`EventListener`, JSX for its components,
    // and react's types for the elements they return.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": false
  },
  // `exclude` is inherited from ./tsconfig.json, which lists "tests" — and
  // `exclude` is applied AFTER `include`, so without this override the
  // `tests/**/*.ts` pattern below was pruned again and the whole project
  // checked only `src/**` while reporting success. `client` (the built bundle
  // directory) and `lib` stay out; `src/client` must stay IN, because the
  // specs import its components and its `globals.d.ts` carries the ambient
  // `*.module.css` declaration they need.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["lib", "node_modules", "client"]
}
